# Copy to platform/.env and adjust. platform/.env is git-ignored.
# `make platform-init` generates one with fresh random credentials.

CF_API=https://api.cf.127-0-0-1.nip.io
CF_ADMIN_USER=ccadmin

# This demo lives in its own org and space so it cannot collide with anything
# else already running on the cluster.
CF_ORG=golden
CF_SPACE=dev
CF_APPS_DOMAIN=apps.127-0-0-1.nip.io

# The one bootstrap credential the platform holds: the config server's Vault token.
VAULT_ROOT_TOKEN=replace-me

# What applications use to authenticate to the config server. Developers never
# type this; it reaches them through a service binding.
CONFIG_CLIENT_USERNAME=golden
CONFIG_CLIENT_PASSWORD=replace-me

# Where the model lives. A location, not a secret.
OLLAMA_BASE_URL=http://juice:11434
OLLAMA_MODEL=muse-glimmer:30b-mlx
